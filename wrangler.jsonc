{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cubefun",
  "compatibility_date": "2026-09-08",
  "observability": {
    "enabled": true
  },
  // 纯静态站点：整个仓库目录即 assets 目录。
  // 关键：必须把 node_modules 等排除掉 —— 构建机会先 npm install，
  // 而 wrangler 自带的 workerd 二进制有 147 MiB，超过 Workers 单文件 25 MiB 上限。
  // 排除后实际上传内容约 350 KB。
  "assets": {
    "directory": ".",
    "exclude": [
      "node_modules",
      "node_modules/**",
      ".git/**",
      ".github/**",
      ".workbuddy/**",
      "tests/**",
      "*.md",
      "package.json",
      "package-lock.json",
      "wrangler.jsonc",
      "wrangler.toml",
      ".gitignore",
      ".assetsignore",
      ".editorconfig"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
